# - DocumentSplitterTest#split_all_varargs, TextSegmentTransformerTest#transform_all_varargs_null_input_returns_empty_list,
#   ChatMemoryTest#add_varargs_should_ignore_null_array and #set_varargs_should_fail_on_null pass a null array into a
#   varargs method whose body handles it. Kotlin checks the array behind a vararg parameter for null on entry ("Parameter
